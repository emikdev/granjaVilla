import wollok.game.*
import src.hector.*
import src.cultivos.*

program farmville {

	game.title("La granja de Héctor")

	game.height(10)
	game.width(10)

	game.ground("ground.png")

	// Visual de Hector
	game.addVisualCharacter(hector)

	// Input's

	keyboard.m().onPressDo {

		hector.sembrarMaiz()

	}

	keyboard.t().onPressDo {

		hector.sembrarTrigo()

	}

	keyboard.o().onPressDo {

		hector.sembrarTomaco()

	}

	keyboard.r().onPressDo {

		hector.regar()

	}

	keyboard.c().onPressDo {

		hector.cosechar()

	}

	keyboard.v().onPressDo {

		hector.vender()

	}

	keyboard.space().onPressDo {

		hector.informar()

	}

	game.start()

}